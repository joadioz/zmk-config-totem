#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

/ {
    combos {
        compatible = "zmk,combos";

        dobleCtrl {
            bindings = <&kp F13>;
            key-positions = <20 31>;
        };
    };

    macros {
pregunta: pregunta {
    compatible = "zmk,behavior-macro";
    #binding-cells = <0>;
    label = "¿";
    bindings = <
        &kp RA(SLSH)   // AltGr + / → ¿  (en layout español)
    >;
};
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
                  &kp Q  &kp W  &kp E   &kp R           &kp T    &kp Y      &kp U  &kp I      &kp O    &kp P
                  &kp A  &kp S  &kp D   &kp F           &kp G    &kp H      &kp J  &kp K      &kp L    &kp RIGHT_ALT
&kp LEFT_CONTROL  &kp Z  &kp X  &kp C   &kp V           &kp B    &kp N      &kp M  &kp COMMA  &kp DOT  &kp LEFT_ALT   &kp LEFT_CONTROL
                                &tog 3  &kp LEFT_SHIFT  &mo 1    &kp SPACE  &mo 2  &mo 4
            >;
        };

        nav_num {
            bindings = <
                  &kp ESCAPE     &kp BACKSPACE     &kp UP     &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS    &kp NUMBER_1  &kp NUMBER_2    &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5
                  &kp TAB        &kp LEFT          &kp DOWN   &kp RIGHT             &kp COMMA                &kp NUMBER_6  &kp NUMBER_7    &kp NUMBER_8  &kp NUMBER_9  &kp NUMBER_0
&kp LEFT_CONTROL  &kp LESS_THAN  &kp GREATER_THAN  &kp ENTER  &kp LEFT_BRACKET      &kp RIGHT_BRACKET        &kp PERIOD    &kp PLUS        &kp MINUS     &kp STAR      &kp LEFT_ALT  &kp LEFT_CONTROL
                                                   &trans     &trans                &none                    &kp LEFT_ALT  &kp LEFT_SHIFT  &kp PERCENT
            >;
        };

        simbols_and_F1-16 {
            bindings = <
               &kp ESC        &kp SQT               &kp DOUBLE_QUOTES  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS    &kp F1        &kp F2   &kp F3        &kp F4   &kp F5
               &kp LA(TAB)    &kp NON_US_BACKSLASH  &kp SLASH          &kp LEFT_BRACE        &kp RIGHT_BRACE          &kp F6        &kp F7   &kp F8        &kp F9   &kp LEFT_ALT
&kp LC(LS(B))  &kp LESS_THAN  &kp GREATER_THAN      &kp UNDERSCORE     &kp LEFT_BRACKET      &kp RIGHT_BRACKET        &kp F11       &kp F12  &kp F13       &kp F14  &kp F10       &kp F16
                                                    &trans             &trans                &kp LEFT_ALT             &kp LEFT_ALT  &none    &kp LEFT_WIN
            >;
        };

        window_manage {
            bindings = <
                  &kp ESCAPE     &kp LC(LA(A))  &kp LA(W)      &kp LA(LC(D))  &kp LS(LA(W))    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
                  &kp LA(LS(A))  &kp LA(A)      &kp LA(S)      &kp LA(D)      &kp LS(LA(D))    &none         &none         &none         &none         &bt BT_CLR
&kp LEFT_CONTROL  &none          &none          &kp LS(LA(S))  &kp LA(V)      &kp LA(M)        &kp LG(E)     &none         &none         &none         &none         &bt BT_CLR
                                                &tog 3         &none          &tog 3           &none         &none         &kp LEFT_WIN
            >;
        };

        unnicode_simbols {
            bindings = <
        &kp PIPE  &kp AMPERSAND  &kp AT      &kp POUND  &kp AMPERSAND    &none   &trans  &pregunta  &kp QUESTION  &kp EQUAL
        &trans    &trans         &kp DOLLAR  &trans     &trans           &trans  &trans  &trans     &trans        &kp COLON
&trans  &trans    &trans         &trans      &trans     &trans           &trans  &trans  &trans     &kp COMMA     &kp SEMI   &trans
                                 &trans      &trans     &trans           &trans  &trans  &trans
            >;
        };
    };

    conditional_layers { compatible = "zmk,conditional-layers"; };
};
