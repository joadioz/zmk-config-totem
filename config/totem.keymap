//                                                        █   █  █  █   █  █  █   █  █  █   █
//                                                         ▀▀▀   █   ▀▀▀   █   ▀▀▀   ▀   ▀▀▀
//                                                               █      ▄▄▄█▄▄▄    █   █  
//                                                               ▀      █  █  █     █▄█
//                                                             ▀▀▀▀▀    █  █  █      ▀
//                                                                      ▀  ▀  ▀
//
// ▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄▄

#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>

&mt {
    flavor = "balanced";
    quick-tap-ms = <175>;
    tapping-term-ms = <1280>;
    require-prior-idle-ms = <150>;
    hold-trigger-on-release;
    hold-trigger-key-positions = <33 32 20 31>;
};

&lt { tapping-term-ms = <140>; };

/ {
    combos {
        compatible = "zmk,combos";

        dobleCtrl {
            bindings = <&kp F13>;
            key-positions = <20 31>;
        };

        newCap {
            bindings = <&mo 4>;
            key-positions = <35 34>;
            layers = <0>;
            timeout-ms = <0>;
        };

        winE {
            bindings = <&kp LG(E)>;
            key-positions = <1 2>;
            layers = <0>;
        };

        ctrlAlt {
            bindings = <&kp LC(A)>;
            key-positions = <10 34>;
        };

        controlX {
            bindings = <&kp LC(X)>;
            key-positions = <11 12>;
        };

        ctrlV {
            bindings = <&kp LC(V)>;
            key-positions = <12 13>;
        };

        ctrlC {
            bindings = <&kp LC(C)>;
            key-positions = <22 23>;
        };

        altf4 {
            bindings = <&kp LA(F4)>;
            key-positions = <15 16>;
        };

        f6 {
            bindings = <&kp F6>;
            key-positions = <16 35>;
        };

        ctrlZ {
            bindings = <&kp LC(Z)>;
            key-positions = <21 22>;
        };

        ctrlShiftZ {
            bindings = <&kp LC(RS(Z))>;
            key-positions = <21 22 23>;
        };
    };

    macros {
        pregunta: new_macro {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LALT>,
                <&macro_tap>,
                <&kp KP_N1 &kp KP_N6 &kp KP_N8>,
                <&macro_release>,
                <&kp LEFT_ALT>;

            label = "NEW_MACRO";
        };

        exclamacion: exclamacion {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_N1>,
                <&macro_tap>,
                <&kp KP_N7>,
                <&macro_tap>,
                <&kp KP_N3>,
                <&macro_release>,
                <&kp LEFT_ALT>;
        };

        em_dash: em_dash {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_N0>,
                <&macro_tap>,
                <&kp KP_N1>,
                <&macro_tap>,
                <&kp KP_N5>,
                <&macro_tap>,
                <&kp KP_N1>,
                <&macro_release>,
                <&kp LEFT_ALT>;
        };

        guillemet_left: guillemet_left {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_N0>,
                <&macro_tap>,
                <&kp KP_N1>,
                <&macro_tap>,
                <&kp KP_N7>,
                <&macro_tap>,
                <&kp KP_N1>,
                <&macro_release>,
                <&kp LEFT_ALT>;
        };

        guillemet_right: guillemet_right {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings =
                <&macro_press>,
                <&kp LEFT_ALT>,
                <&macro_tap>,
                <&kp KP_N0>,
                <&macro_tap>,
                <&kp KP_N1>,
                <&macro_tap>,
                <&kp KP_N8>,
                <&macro_tap>,
                <&kp KP_N7>,
                <&macro_release>,
                <&kp LEFT_ALT>;
        };
    };

    behaviors {
        cutPaste: cutPaste {
            compatible = "zmk,behavior-hold-tap";
            label = "CUTPASTE";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <1200>;
            quick-tap-ms = <175>;
            hold-trigger-key-positions = <21 23 24 22>;
            hold-trigger-on-release;
            flavor = "balanced";
        };
    };

    keymap {
        compatible = "zmk,keymap";

        base {
            bindings = <
                  &kp Q           &kp W  &kp E    &kp R           &kp T          &kp Y        &kp U  &kp I      &kp O    &kp P
                  &mt LEFT_ALT A  &kp S  &kp D    &kp F           &kp G          &kp H        &kp J  &kp K      &kp L    &kp RIGHT_ALT
&kp LEFT_CONTROL  &kp Z           &kp X  &kp C    &kp V           &kp B          &kp N        &kp M  &kp COMMA  &kp DOT  &kp LEFT_ALT   &kp LEFT_CONTROL
                                         &kp TAB  &kp LEFT_SHIFT  &lt 1 SPACE    &lt 4 SPACE  &mo 2  &mo 4
            >;
        };

        nav_num {
            bindings = <
           &kp ESCAPE  &kp BACKSPACE  &kp UP        &kp LC(LS(TAB))  &kp LC(TAB)    &kp NUMBER_1  &kp NUMBER_2    &kp NUMBER_3  &kp NUMBER_4  &kp NUMBER_5
           &kp LC(C)   &kp LEFT       &kp DOWN      &kp RIGHT        &kp LC(W)      &kp NUMBER_6  &kp LCTRL       &kp RSHFT     &kp LEFT_ALT  &kp TAB
&kp RC(X)  &kp LC(X)   &kp LC(V)      &kp ENTER     &kp LC(N)        &kp LC(T)      &kp PERIOD    &kp K_COPY      &kp MINUS     &kp STAR      &kp LEFT_ALT  &kp LEFT_CONTROL
                                      &kp LEFT_WIN  &kp LEFT_ALT     &none          &mo 4         &kp LEFT_SHIFT  &kp PERCENT
            >;
        };

        simbols_and_F1-16 {
            bindings = <
               &kp ESC        &kp SQT               &kp DOUBLE_QUOTES  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS    &kp F1        &kp F2   &kp F3        &kp F4   &kp F5
               &kp LA(TAB)    &kp NON_US_BACKSLASH  &kp SLASH          &kp LEFT_BRACE        &kp RIGHT_BRACE          &kp F6        &kp F7   &kp F8        &kp F9   &kp LEFT_ALT
&kp LC(LS(B))  &kp LESS_THAN  &kp GREATER_THAN      &kp UNDERSCORE     &kp LEFT_BRACKET      &kp RIGHT_BRACKET        &kp F11       &kp F12  &kp F13       &kp F14  &kp F10       &kp F16
                                                    &trans             &trans                &kp LEFT_ALT             &kp LEFT_ALT  &none    &kp LEFT_WIN
            >;
        };

        window_manage {
            bindings = <
                  &kp ESCAPE     &kp LC(LA(A))  &kp LA(W)      &kp LA(LC(D))  &kp LS(LA(W))    &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
                  &kp LA(LS(A))  &kp LA(A)      &kp LA(S)      &kp LA(D)      &kp LS(LA(D))    &none         &none         &none         &none         &bt BT_CLR
&kp LEFT_CONTROL  &none          &none          &kp LS(LA(S))  &kp LA(V)      &kp LA(M)        &kp LG(E)     &none         &none         &none         &none         &bt BT_CLR
                                                &tog 3         &none          &tog 3           &none         &none         &kp LEFT_WIN
            >;
        };

        unnicode_simbols {
            bindings = <
        &kp PIPE  &kp AMPERSAND  &kp AT      &kp POUND  &kp AMPERSAND    &exclamacion  &kp EXCLAMATION  &pregunta  &kp QUESTION  &kp EQUAL
        &trans    &trans         &kp DOLLAR  &trans     &kp COLON        &trans        &trans           &trans     &trans        &kp COLON
&trans  &trans    &trans         &trans      &em_dash   &kp MINUS        &trans        &trans           &trans     &kp COMMA     &kp SEMI   &trans
                                 &trans      &trans     &trans           &trans        &trans           &trans
            >;
        };
    };

    conditional_layers {
        compatible = "zmk,conditional-layers";

        condition {
            if-layers = <1 4>;
            then-layer = <4>;
        };
    };
};
